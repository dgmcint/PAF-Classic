msgstr "{file}(으)로 내보냈습니다."

msgid ""
"The file could not be saved:\n"
"{error}"
msgstr ""
"파일을 저장할 수 없습니다:\n"
"{error}"

msgid "Open the backup {file} as the current family? Save it with Save As to replace your file."
msgstr "백업 {file}을(를) 현재 가족으로 여시겠습니까? 파일을 바꾸려면 다른 이름으로 저장으로 저장하십시오."

msgid ""
"This backup could not be read:\n"
"{error}"
msgstr ""
"이 백업을 읽을 수 없습니다:\n"
"{error}"

msgid "Permanently delete {file}? This cannot be undone."
msgstr "{file}을(를) 영구히 삭제하시겠습니까? 되돌릴 수 없습니다."

msgid ""
"The file could not be deleted:\n"
"{error}"
msgstr ""
"파일을 삭제할 수 없습니다:\n"
"{error}"

msgid "Starting person: {name}"
msgstr "시작하는 사람: {name}"

msgid "Prints {n} individual. Use Advanced Focus/Filter to choose fewer."
msgid_plural "Prints {n} individuals. Use Advanced Focus/Filter to choose fewer."
msgstr[0] "개인 {n}명을 인쇄합니다. 더 적게 선택하려면 고등 초점/필터를 사용하십시오."

msgid "Page {page} of {pages}"
msgstr "{pages}페이지 중 {page}페이지"

msgid ""
"The report could not be saved:\n"
"{error}"
msgstr ""
"보고서를 저장할 수 없습니다:\n"
"{error}"

msgid "Parents: {names}"
msgstr "부모: {names}"

msgid "Spouse: {name}"
msgstr "배우자: {name}"

msgid "The christening date is more than {years} years after the birth date."
msgstr "명명 날짜가 출생 날짜보다 {years}년 이상 늦습니다."

msgid "The death date is more than {years} years after the birth or christening date."
msgstr "사망 날짜가 출생 또는 명명 날짜보다 {years}년 이상 늦습니다."

msgid "The burial date is more than {years} years after the birth or christening date."
msgstr "매장 날짜가 출생 또는 명명 날짜보다 {years}년 이상 늦습니다."

msgid "The burial date is more than {n} year after the death date."
msgid_plural "The burial date is more than {n} years after the death date."
msgstr[0] "매장 날짜가 사망 날짜보다 {n}년 이상 늦습니다."

msgid "The individual's birth/christening date is less than {years} years after a parent's birth/christening date."
msgstr "이 사람의 출생 또는 명명 날짜가 부모의 출생 또는 명명 날짜로부터 {years}년이 되지 않습니다."

msgid "The individual's birth/christening date is more than {years} years after the father's birth/christening date."
msgstr "이 사람의 출생 또는 명명 날짜가 아버지의 출생 또는 명명 날짜보다 {years}년 이상 늦습니다."

msgid "The individual's birth/christening date is more than {years} years after the mother's birth/christening date."
msgstr "이 사람의 출생 또는 명명 날짜가 어머니의 출생 또는 명명 날짜보다 {years}년 이상 늦습니다."

msgid "The sealing date is before a spouse's birth or christening date (MRIN {mrin})."
msgstr "인봉 날짜가 배우자의 출생 또는 명명 날짜보다 이릅니다 (MRIN {mrin})."

msgid "The sealing date is before the age of {years} (MRIN {mrin})."
msgstr "인봉 날짜가 {years}세 이전입니다 (MRIN {mrin})."

msgid "The marriage date is before a spouse's birth or christening date (MRIN {mrin})."
msgstr "결혼 날짜가 배우자의 출생 또는 명명 날짜보다 이릅니다 (MRIN {mrin})."

msgid "The marriage date is less than {years} years after a spouse's birth or christening (MRIN {mrin})."
msgstr "결혼 날짜가 배우자의 출생 또는 명명으로부터 {years}년이 되지 않습니다 (MRIN {mrin})."

msgid "The marriage date is more than {years} years after a spouse's birth or christening date (MRIN {mrin})."
msgstr "결혼 날짜가 배우자의 출생 또는 명명 날짜보다 {years}년 이상 늦습니다 (MRIN {mrin})."

msgid "The marriage date is after a spouse's death date (MRIN {mrin})."
msgstr "결혼 날짜가 배우자의 사망 날짜보다 늦습니다 (MRIN {mrin})."

msgid "Age between husband and wife is greater than {years} years (MRIN {mrin})."
msgstr "남편과 아내의 나이 차이가 {years}년보다 큽니다 (MRIN {mrin})."

msgid "The children in marriage {mrin} are not in birth order."
msgstr "결혼 {mrin}의 자녀들이 출생 순서대로 되어 있지 않습니다."

msgid "Other marriages ({at}/{count})"
msgstr "다른 결혼 ({at}/{count})"

msgid "Other parents ({count})"
msgstr "다른 부모 ({count})"

msgid "Father's age at this birth, {age}, is outside {low} to {high} years."
msgstr "이 출생 때 아버지의 나이 {age}세가 {low}~{high}세 범위를 벗어납니다."

msgid "Mother's age at this birth, {age}, is outside {low} to {high} years."
msgstr "이 출생 때 어머니의 나이 {age}세가 {low}~{high}세 범위를 벗어납니다."

msgid "{name}   {rin}   b. {date}"
msgstr "{name}   {rin}   출생 {date}"

msgid "{father} and {mother}  (MRIN {mrin})"
msgstr "{father}, {mother}  (MRIN {mrin})"
