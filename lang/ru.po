msgstr "Дата брака раньше даты рождения или крещения одного из супругов (MRIN {mrin})."

msgid "The marriage date is less than {years} years after a spouse's birth or christening (MRIN {mrin})."
msgstr "Между рождением или крещением одного из супругов и датой брака прошло менее {years} лет (MRIN {mrin})."

msgid "The marriage date is more than {years} years after a spouse's birth or christening date (MRIN {mrin})."
msgstr "Между датой рождения или крещения одного из супругов и датой брака прошло более {years} лет (MRIN {mrin})."

msgid "The marriage date is after a spouse's death date (MRIN {mrin})."
msgstr "Дата брака позже даты смерти одного из супругов (MRIN {mrin})."

msgid "Age between husband and wife is greater than {years} years (MRIN {mrin})."
msgstr "Разница в возрасте мужа и жены больше {years} лет (MRIN {mrin})."

msgid "The children in marriage {mrin} are not in birth order."
msgstr "Дети в браке {mrin} не упорядочены по дате рождения."

msgid "Other marriages ({at}/{count})"
msgstr "Другие браки ({at}/{count})"

msgid "Other parents ({count})"
msgstr "Другие родители ({count})"

msgid "Father's age at this birth, {age}, is outside {low} to {high} years."
msgstr "Возраст отца при этом рождении, {age}, вне диапазона от {low} до {high} лет."

msgid "Mother's age at this birth, {age}, is outside {low} to {high} years."
msgstr "Возраст матери при этом рождении, {age}, вне диапазона от {low} до {high} лет."

msgid "{name}   {rin}   b. {date}"
msgstr "{name}   {rin}   р. {date}"

msgid "{father} and {mother}  (MRIN {mrin})"
msgstr "{father} и {mother}  (MRIN {mrin})"
